---
/**
 * Layout base — todas as páginas usam este layout.
 *
 * Identidade visual original:
 *  - Logo "JC" em SVG (preto + mostarda) inline como favicon
 *  - DM Serif Display + Inter + JetBrains Mono
 *  - Tags mono pra metadados (sem caixa-alta agressiva)
 *  - JSON-LD com tipo "Person" + "PoliticalOrganization"
 */

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE } from '../site.config.js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title = SITE.seo.title,
  description = SITE.seo.description,
  ogImage = SITE.seo.ogImage,
  pageType = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullOgImage = new URL(ogImage, Astro.site).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  affiliation: {
    '@type': 'PoliticalParty',
    name: SITE.partyFull,
  },
  url: Astro.site?.toString(),
  sameAs: [SITE.contacts.instagram, SITE.contacts.tiktok].filter(Boolean),
  description: SITE.shortBio,
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'PoliticalOrganization',
  name: `Campanha ${SITE.name} 2026`,
  url: Astro.site?.toString(),
  logo: fullOgImage,
  sameAs: [SITE.contacts.instagram].filter(Boolean),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.seo.keywords} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' fill='%23111111'/><text x='20' y='28' text-anchor='middle' fill='%23E5B833' font-family='Georgia,serif' font-size='22' font-style='italic'>JC</text></svg>" />

    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={`Campanha ${SITE.name}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content={SITE.seo.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class={bodyClass}>
    <a href="#main" class="skip-link">Pular pro conteúdo</a>

    <Header />

    <main id="main" role="main">
      <slot />
    </main>

    <Footer />

    <WhatsAppFloat />
    <CookieBanner />
  </body>
</html>
