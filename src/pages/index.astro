---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE, PILLARS, GALLERY, QUOTES } from '../site.config.js';
---

<Layout
  title={`${SITE.name} · ${SITE.role} · ${SITE.number}`}
  description={SITE.shortBio}
  pageType="profile"
>
  <!-- =========== HERO EDITORIAL =========== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__container container">
      <div class="hero__copy">
        <p class="hero__eyebrow">
          <span class="dot"></span>
          {SITE.home.heroEyebrow}
        </p>

        <h1 id="hero-title" class="hero__title">
          Não vim buscar <span class="hero__title-mark">benefício</span> do cargo.
          <span class="hero__title-italic">Vim fiscalizar.</span>
        </h1>

        <p class="hero__subtitle">
          {SITE.subtitle}
        </p>

        <div class="hero__actions">
          <Button href="/propostas/" variant="primary" size="lg">
            {SITE.home.ctaPrimary}
          </Button>
          <Button
            href={`https://wa.me/${SITE.contacts.whatsapp}?text=${encodeURIComponent('Olá Juliana, vim pelo site e quero conversar.')}`}
            variant="outline"
            size="lg"
            external
          >
            {SITE.home.ctaSecondary}
          </Button>
        </div>

        <dl class="hero__meta" aria-label="Identificação da campanha">
          <div>
            <dt>Número</dt>
            <dd>{SITE.number}</dd>
          </div>
          <div>
            <dt>Cargo</dt>
            <dd>Deputada Federal</dd>
          </div>
          <div>
            <dt>Partido</dt>
            <dd>Missão</dd>
          </div>
          <div>
            <dt>Base</dt>
            <dd>Jundiaí-SP</dd>
          </div>
        </dl>
      </div>

      <figure class="hero__portrait">
        <img
          src="/images/juliana-retrato-branco.jpg"
          alt="Juliana Constantino, de camisa branca, braços cruzados, em fundo neutro, com olhar firme e direto — chamando a atenção para o que importa."
          width="1200"
          height="1500"
          fetchpriority="high"
        />
        <figcaption>
          <span class="hero__caption-tag">Foto oficial da campanha</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- =========== MANIFESTO =========== -->
  <section class="manifesto" aria-labelledby="manifesto-title">
    <div class="container">
      <p class="manifesto__eyebrow">Por que me candidatar</p>
      <h2 id="manifesto-title" class="manifesto__title">
        O Congresso virou balcão de negócios.
        <em>Não é pra isso que ele existe.</em>
      </h2>
      <div class="manifesto__body">
        <p>
          {SITE.home.manifesto}
        </p>
        <p class="manifesto__signature">
          <span>— Juliana Constantino</span>
          <span class="tag-mono">Jundiaí-SP · 2026</span>
        </p>
      </div>
    </div>
  </section>

  <!-- =========== NÚMERO 1424 — bloco editorial =========== -->
  <section class="numero" id="vote" aria-labelledby="numero-title">
    <div class="container numero__inner">
      <p class="numero__eyebrow">Vote consciente</p>
      <h2 id="numero-title" class="numero__title">
        <span>Na urna, anote:</span>
        <span class="numero__digits" aria-label={`Número ${SITE.number}, Deputada Federal`}>
          {SITE.number}
        </span>
        <span class="numero__sub">para Deputada Federal · Partido Missão</span>
      </h2>
      <p class="numero__instrucao">
        <strong>1424</strong> para Deputada Federal. Vote também nos candidatos
        da base aliada a presidente, governador e senador. Fiscalizar é um
        trabalho conjunto — começa na urna e continua no mandato.
      </p>
    </div>
  </section>

  <!-- =========== PROPOSTAS EM 5 EIXOS =========== -->
  <section class="propostas" aria-labelledby="propostas-title">
    <div class="container">
      <header class="section__header">
        <p class="section__eyebrow">Cinco frentes de trabalho</p>
        <h2 id="propostas-title" class="section__title">
          Menos privilégio, mais resultado.
        </h2>
      </header>

      <div class="propostas__grid">
        {PILLARS.map((p) => (
          <article class="proposta-card">
            <div class="proposta-card__top">
              <span class="proposta-card__numero">{p.numero}</span>
              <h3 class="proposta-card__titulo">{p.titulo}</h3>
            </div>
            <p class="proposta-card__resumo">{p.resumo}</p>
            <ul class="proposta-card__acoes">
              {p.acoes.map((a) => (
                <li>
                  <span class="proposta-card__bullet" aria-hidden="true">→</span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="propostas__cta">
        <Button href="/propostas/" variant="primary" size="md">
          Ver todas as propostas detalhadas
        </Button>
      </div>
    </div>
  </section>

  <!-- =========== FRASES / CITAÇÕES =========== -->
  <section class="quotes" aria-labelledby="quotes-title">
    <div class="container">
      <h2 id="quotes-title" class="visually-hidden">Frases da campanha</h2>
      <ul class="quotes__list">
        {QUOTES.map((q, i) => (
          <li class="quote-item">
            <span class="quote-item__num tag-mono">0{i + 1}</span>
            <p class="quote-item__text">{q}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =========== GALERIA =========== -->
  <section class="galeria" aria-labelledby="galeria-title">
    <div class="container">
      <header class="section__header">
        <p class="section__eyebrow">Da campanha</p>
        <h2 id="galeria-title" class="section__title">
          Uma candidata, uma postura.
        </h2>
      </header>

      <div class="galeria__grid">
        {GALLERY.slice(0, 6).map((photo, i) => (
          <figure class={`galeria__item galeria__item--${i + 1}`}>
            <img
              src={photo.thumb}
              alt={photo.alt}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              width="800"
              height="600"
            />
            <figcaption class="galeria__caption">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- =========== CTA FINAL =========== -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="container cta-final__inner">
      <p class="cta-final__eyebrow">Se essa candidatura faz sentido pra você</p>
      <h2 id="cta-title" class="cta-final__title">
        Vamos conversar. Sem filtro, sem promessa vazia.
      </h2>
      <p class="cta-final__body">
        Manda mensagem no WhatsApp, assina a newsletter ou vem fazer parte da
        equipe de voluntários. Quanto mais gente fiscalizando, menos espaço pra
        quem usa o Congresso pra se beneficiar.
      </p>
      <div class="cta-final__actions">
        <a
          class="cta-final__wa"
          href={`https://wa.me/${SITE.contacts.whatsapp}?text=${encodeURIComponent('Quero caminhar com você. Vim pelo site.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Manda mensagem no WhatsApp
        </a>
        <Button href="/apoie/" variant="outline" size="lg">
          Outras formas de apoiar
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====== VISUALLY HIDDEN ====== */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ====== HERO ====== */
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5rem);
    background: var(--papel);
    border-bottom: 1px solid var(--papel-sombra);
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(3rem, 7vw, 6rem);
    }
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--tinta-suave);
    margin: 0 0 var(--space-5);
  }

  .hero__eyebrow .dot {
    width: 6px;
    height: 6px;
    background: var(--mostarda);
    border-radius: 50%;
    display: inline-block;
  }

  .hero__title {
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(2rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--tinta);
    margin: 0 0 var(--space-4);
    max-width: 18ch;
  }

  .hero__title-mark {
    background: var(--mostarda);
    color: var(--tinta);
    padding: 0.05em 0.25em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero__title-italic {
    display: block;
    font-style: italic;
    color: var(--musgo);
    margin-top: 0.25em;
  }

  .hero__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.125rem, 1.9vw, 1.4375rem);
    line-height: 1.4;
    color: var(--tinta-media);
    margin: 0 0 var(--space-7);
    max-width: 30rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--papel-sombra);
    margin: 0;
  }

  @media (min-width: 540px) {
    .hero__meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .hero__meta div { margin: 0; }
  .hero__meta dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--tinta-suave);
    margin: 0 0 4px;
  }
  .hero__meta dd {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--tinta);
    margin: 0;
  }

  .hero__portrait {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--papel-sombra);
    box-shadow: var(--shadow-hero);
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: contrast(1.02);
  }

  .hero__portrait figcaption {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
  }

  .hero__caption-tag {
    display: inline-block;
    padding: 0.4rem 0.625rem;
    background: var(--papel);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--tinta);
  }

  /* ====== MANIFESTO ====== */
  .manifesto {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--papel-puro);
    border-bottom: 1px solid var(--papel-sombra);
  }

  .manifesto__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda-escura);
    margin: 0 0 var(--space-4);
  }

  .manifesto__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    color: var(--tinta);
    margin: 0 0 var(--space-6);
    max-width: 28ch;
  }

  .manifesto__title em {
    font-style: italic;
    color: var(--musgo);
  }

  .manifesto__body p {
    font-family: var(--font-corpo);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--tinta-media);
    margin: 0 0 var(--space-4);
    max-width: 36rem;
  }

  .manifesto__signature {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    padding-top: var(--space-3);
    border-top: 1px solid var(--papel-sombra);
    max-width: 36rem;
  }

  .manifesto__signature span:first-child {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--tinta);
  }

  /* ====== NÚMERO ====== */
  .numero {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--tinta);
    color: var(--papel);
  }

  .numero__inner {
    display: grid;
    gap: var(--space-5);
    text-align: left;
    max-width: 48rem;
  }

  .numero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda);
    margin: 0;
  }

  .numero__title {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .numero__title span:first-child {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: rgba(245, 241, 232, 0.7);
  }

  .numero__digits {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 8rem);
    line-height: 0.9;
    color: var(--mostarda);
    letter-spacing: -0.04em;
  }

  .numero__sub {
    font-family: var(--font-corpo);
    font-size: var(--text-md);
    color: var(--papel);
    font-weight: var(--weight-medium);
  }

  .numero__instrucao {
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: rgba(245, 241, 232, 0.7);
    margin: 0;
    max-width: 40rem;
  }

  .numero__instrucao strong {
    color: var(--mostarda);
    font-weight: var(--weight-bold);
  }

  /* ====== SECTION HEADER PADRÃO ====== */
  .section__header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--papel-sombra);
    max-width: 36rem;
  }

  .section__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda-escura);
    margin: 0 0 var(--space-3);
  }

  .section__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.05;
    color: var(--tinta);
    margin: 0;
    max-width: 22ch;
  }

  /* ====== PROPOSTAS ====== */
  .propostas {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--papel);
  }

  .propostas__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 700px) {
    .propostas__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .propostas__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .proposta-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--papel-puro);
    border: 1px solid var(--papel-sombra);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-media), box-shadow var(--transition-media);
  }

  .proposta-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .proposta-card__top {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--papel-sombra);
  }

  .proposta-card__numero {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--mostarda-escura);
    font-weight: var(--weight-medium);
  }

  .proposta-card__titulo {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--tinta);
    margin: 0;
    line-height: 1.15;
  }

  .proposta-card__resumo {
    font-family: var(--font-corpo);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--tinta-media);
    margin: 0 0 var(--space-5);
  }

  .proposta-card__acoes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .proposta-card__acoes li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    font-family: var(--font-corpo);
    font-size: var(--text-sm);
    color: var(--tinta-media);
    line-height: var(--leading-snug);
  }

  .proposta-card__bullet {
    color: var(--mostarda-escura);
    flex-shrink: 0;
    font-weight: var(--weight-bold);
  }

  .propostas__cta {
    margin-top: var(--space-8);
  }

  /* ====== QUOTES ====== */
  .quotes {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--papel-puro);
    border-block: 1px solid var(--papel-sombra);
  }

  .quotes__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    max-width: 72rem;
    margin-inline: auto;
  }

  @media (min-width: 700px) {
    .quotes__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .quotes__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .quote-item {
    padding: var(--space-5);
    background: var(--papel);
    border-left: 3px solid var(--mostarda);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .quote-item__num {
    display: block;
    color: var(--mostarda-escura);
    margin-bottom: var(--space-3);
  }

  .quote-item__text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    line-height: 1.4;
    color: var(--tinta);
    margin: 0;
  }

  /* ====== GALERIA ====== */
  .galeria {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--papel);
  }

  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 200px;
    gap: var(--space-3);
  }

  @media (min-width: 700px) {
    .galeria__grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 220px;
    }
  }

  @media (min-width: 1024px) {
    .galeria__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 240px;
      gap: var(--space-4);
    }
  }

  .galeria__item {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--papel-sombra);
  }

  .galeria__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-lenta);
  }

  .galeria__item:hover img {
    transform: scale(1.04);
  }

  .galeria__item--1 { grid-row: span 2; }
  .galeria__item--4 { grid-row: span 2; }

  .galeria__caption {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    padding: 0.25rem 0.625rem;
    background: var(--papel);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--tinta);
  }

