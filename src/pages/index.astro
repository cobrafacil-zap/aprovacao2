---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Lightbox from '../components/Lightbox.astro';
import { SITE, PILLARS, GALLERY, QUOTES } from '../site.config.js';

// Prepara dados do lightbox
const lightboxPhotos = GALLERY.slice(0, 6).map((p, i) => ({
  id: String(i + 1),
  src: p.src,
  alt: p.alt,
}));
---

<Layout
  title={`${SITE.name} · ${SITE.role} · ${SITE.number}`}
  description={SITE.shortBio}
  pageType="profile"
>
  <!-- =========== HERO EDITORIAL =========== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__dateline">
      <div class="container">
        <span class="hero__dateline-dot" aria-hidden="true"></span>
        <span>{SITE.home.heroEyebrow}</span>
      </div>
    </div>

    <div class="hero__container container">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title">
          Não vim buscar
          <br />
          <span class="hero__title-mark">benefício</span> do cargo.
          <span class="hero__title-italic">Vim fiscalizar.</span>
        </h1>

        <p class="hero__subtitle">
          {SITE.subtitle}
        </p>

        <div class="hero__actions">
          <Button href="/propostas/" variant="primary" size="lg">
            {SITE.home.ctaPrimary}
          </Button>
          <Button href="/sobre/" variant="outline" size="lg">
            Quem é a Juliana
          </Button>
        </div>
      </div>

      <figure class="hero__portrait">
        <button
          type="button"
          class="hero__portrait-btn"
          data-lightbox-trigger="1"
          aria-label="Ampliar foto da candidata"
        >
          <img
            src="/images/juliana-bandeira.jpg"
            alt="Juliana Constantino segurando a bandeira do Partido Missão, com olhar firme e direto."
            width="1400"
            height="1700"
            fetchpriority="high"
          />
        </button>
        <figcaption class="hero__caption">
          <span class="hero__caption-marker" aria-hidden="true">▮</span>
          Juliana Constantino · 1424 · Missão
        </figcaption>
      </figure>
    </div>

    <div class="hero__footer">
      <div class="container hero__footer-inner">
        <dl class="hero__meta" aria-label="Identificação da campanha">
          <div>
            <dt>Número</dt>
            <dd>{SITE.number}</dd>
          </div>
          <div>
            <dt>Cargo</dt>
            <dd>Deputada Federal</dd>
          </div>
          <div>
            <dt>Partido</dt>
            <dd>Missão</dd>
          </div>
          <div>
            <dt>Base</dt>
            <dd>Jundiaí-SP</dd>
          </div>
        </dl>
        <p class="hero__manifesto">
          <strong>Manifesto.</strong>
          {' '}
          {SITE.home.manifesto}
        </p>
      </div>
    </div>
  </section>

  <!-- =========== NÚMERO 1424 — bloco editorial =========== -->
  <section class="numero" id="vote" aria-labelledby="numero-title">
    <div class="container numero__inner">
      <p class="numero__eyebrow">Vote consciente</p>
      <h2 id="numero-title" class="numero__title">
        <span class="numero__pre">Na urna, anote:</span>
        <span class="numero__digits" aria-label={`Número ${SITE.number}, Deputada Federal`}>
          {SITE.number}
        </span>
        <span class="numero__sub">para Deputada Federal · Partido Missão</span>
      </h2>
      <p class="numero__instrucao">
        <strong>1424</strong> para Deputada Federal. Vote também nos candidatos
        da base aliada a presidente, governador e senador. Fiscalizar começa na
        urna e continua no mandato.
      </p>
    </div>
  </section>

  <!-- =========== PROPOSTAS EM 5 EIXOS =========== -->
  <section class="propostas" aria-labelledby="propostas-title">
    <div class="container">
      <header class="section__header">
        <p class="section__eyebrow">Onde vou mexer primeiro</p>
        <h2 id="propostas-title" class="section__title">
          Cinco frentes. Sem promessa grande.
        </h2>
      </header>

      <div class="propostas__grid">
        {PILLARS.map((p) => (
          <article class="proposta-card">
            <div class="proposta-card__top">
              <span class="proposta-card__numero">{p.numero}</span>
              <h3 class="proposta-card__titulo">{p.titulo}</h3>
            </div>
            <p class="proposta-card__resumo">{p.resumo}</p>
            <ul class="proposta-card__acoes">
              {p.acoes.map((a) => (
                <li>
                  <span class="proposta-card__bullet" aria-hidden="true">→</span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="propostas__cta">
        <Button href="/propostas/" variant="primary" size="md">
          Ver todas as propostas detalhadas
        </Button>
      </div>
    </div>
  </section>

  <!-- =========== FRASES / CITAÇÕES =========== -->
  <section class="quotes" aria-labelledby="quotes-title">
    <div class="container">
      <h2 id="quotes-title" class="visually-hidden">Frases da campanha</h2>
      <ul class="quotes__list">
        {QUOTES.map((q, i) => (
          <li class="quote-item">
            <span class="quote-item__num tag-mono">0{i + 1}</span>
            <p class="quote-item__text">{q}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =========== GALERIA =========== -->
  <section class="galeria" aria-labelledby="galeria-title">
    <div class="container">
      <header class="section__header">
        <p class="section__eyebrow">Da campanha</p>
        <h2 id="galeria-title" class="section__title">
          Da rua pro site.
        </h2>
      </header>

      <div class="galeria__grid">
        {GALLERY.slice(0, 6).map((photo, i) => (
          <button
            type="button"
            class={`galeria__item galeria__item--${i + 1}`}
            data-lightbox-trigger={String(i + 1)}
            aria-label={`Amplir foto ${i + 1} da campanha`}
          >
            <img
              src={photo.thumb}
              alt={photo.alt}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              width="800"
              height="600"
            />
            <span class="galeria__zoom" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"/>
                <path d="m21 21-4.3-4.3M11 8v6M8 11h6"/>
              </svg>
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- =========== REDES SOCIAIS =========== -->
  <section class="redes" id="redes-sociais" aria-labelledby="redes-title">
    <div class="container redes__inner">
      <div class="redes__text">
        <p class="redes__eyebrow">Acompanhe nas redes</p>
        <h2 id="redes-title" class="redes__title">
          A campanha também é em rede.
        </h2>
        <p class="redes__body">
          Posts diários no Instagram e no TikTok com o que tá acontecendo
          em Brasília e na rua. Se concorda, segue. Se discorda, comenta —
          leio tudo.
        </p>
      </div>

      <div class="redes__cards">
        {SITE.contacts.instagram && (
          <a class="redes__card" href={SITE.contacts.instagram} target="_blank" rel="noopener noreferrer">
            <span class="redes__card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg>
            </span>
            <span class="redes__card-text">
              <strong>Instagram</strong>
              <span>@julianaconstantino</span>
            </span>
            <span class="redes__card-arrow" aria-hidden="true">→</span>
          </a>
        )}
        {SITE.contacts.tiktok && (
          <a class="redes__card" href={SITE.contacts.tiktok} target="_blank" rel="noopener noreferrer">
            <span class="redes__card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 7.6a5.7 5.7 0 0 1-3.4-1.1 5.7 5.7 0 0 1-2.2-4V2h-3v12.6a2.7 2.7 0 1 1-2-2.6V9a5.7 5.7 0 1 0 5 5.6V9.5a8.6 8.6 0 0 0 5.6 2V8.6a5.7 5.7 0 0 1-1 0z"/></svg>
            </span>
            <span class="redes__card-text">
              <strong>TikTok</strong>
              <span>@julianaconstantino</span>
            </span>
            <span class="redes__card-arrow" aria-hidden="true">→</span>
          </a>
        )}
        {SITE.contacts.facebook && (
          <a class="redes__card" href={SITE.contacts.facebook} target="_blank" rel="noopener noreferrer">
            <span class="redes__card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M14 13.5h2.5l1-4H14V7c0-1.1.5-2 2-2h1.5V1.7A18.4 18.4 0 0 0 15.4 1.5C13 1.5 11.5 3 11.5 5.6v3.9H9v4H11.5V22h2.5v-8.5z"/></svg>
            </span>
            <span class="redes__card-text">
              <strong>Facebook</strong>
              <span>Juliana Constantino</span>
            </span>
            <span class="redes__card-arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <Lightbox photos={lightboxPhotos} title="Galeria da campanha" />
</Layout>

<style>
  /* ====== VISUALLY HIDDEN ====== */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ====== HERO editorial pesado ====== */
  .hero {
    background: var(--papel);
    padding-block: 0 0;
  }

  .hero__dateline {
    background: var(--tinta);
    color: var(--mostarda);
    padding-block: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
  }

  .hero__dateline .container {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hero__dateline-dot {
    width: 8px;
    height: 8px;
    background: var(--mostarda);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: end;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    max-width: 1400px;
    margin-inline: auto;
  }

  @media (min-width: 960px) {
    .hero__container {
      grid-template-columns: 1.35fr 1fr;
      gap: clamp(3rem, 7vw, 7rem);
      padding-inline: clamp(2rem, 5vw, 4rem);
    }
  }

  /* manchete gigante, serifada, sem max-width apertado */
  .hero__title {
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--tinta);
    margin: 0 0 var(--space-5);
    overflow-wrap: break-word;
  }

  .hero__title-mark {
    background-image: linear-gradient(
      transparent 0%,
      transparent 14%,
      var(--mostarda) 14%,
      var(--mostarda) 92%,
      transparent 92%
    );
    background-repeat: no-repeat;
    padding: 0.08em 0.18em 0.12em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero__title-italic {
    display: block;
    font-style: italic;
    color: var(--musgo);
    margin-top: 0.35em;
    font-size: 0.85em;
  }

  .hero__subtitle {
    font-family: var(--font-corpo);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--tinta-media);
    margin: 0 0 var(--space-7);
    max-width: 32rem;
    border-left: 2px solid var(--mostarda);
    padding-left: var(--space-4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* FOTO SANGRADA, sem card, sem border-radius */
  .hero__portrait {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero__portrait-btn {
    display: block;
    width: 100%;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: zoom-in;
    overflow: hidden;
    position: relative;
  }

  .hero__portrait-btn img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: contrast(1.02) saturate(0.95);
    transition: transform 280ms ease, filter 280ms ease;
  }

  .hero__portrait-btn:hover img {
    transform: scale(1.02);
    filter: contrast(1.04) saturate(1);
  }

  .hero__caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--tinta-suave);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__caption-marker {
    color: var(--mostarda-escura);
    font-size: 0.6rem;
  }

  /* RODAPÉ do hero: regra grossa preta separando manifesto */
  .hero__footer {
    border-top: 6px solid var(--tinta);
    padding-block: var(--space-7);
  }

  .hero__footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 720px) {
    .hero__footer-inner {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-10);
    }
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin: 0;
  }

  @media (min-width: 540px) {
    .hero__meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .hero__meta div { margin: 0; }
  .hero__meta dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--tinta-suave);
    margin: 0 0 4px;
  }
  .hero__meta dd {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--tinta);
    margin: 0;
  }

  .hero__manifesto {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--tinta);
  }

  .hero__manifesto strong {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda-escura);
    display: inline-block;
    margin-right: var(--space-3);
    padding: 4px 8px;
    border: 1px solid var(--tinta);
    font-weight: var(--weight-medium);
  }

  /* ====== NÚMERO ====== */
  .numero {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--tinta);
    color: var(--papel);
  }

  .numero__inner {
    display: grid;
    gap: var(--space-5);
    text-align: left;
    max-width: 48rem;
  }

  .numero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda);
    margin: 0;
  }

  .numero__title {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .numero__pre {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: rgba(245, 241, 232, 0.7);
  }

  .numero__digits {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 8rem);
    line-height: 0.9;
    color: var(--mostarda);
    letter-spacing: -0.04em;
  }

  .numero__sub {
    font-family: var(--font-corpo);
    font-size: var(--text-md);
    color: var(--papel);
    font-weight: var(--weight-medium);
  }

  .numero__instrucao {
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: rgba(245, 241, 232, 0.7);
    margin: 0;
    max-width: 40rem;
  }

  .numero__instrucao strong {
    color: var(--mostarda);
    font-weight: var(--weight-bold);
  }

  /* ====== SECTION HEADER PADRÃO ====== */
  .section__header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--papel-sombra);
    max-width: 36rem;
  }

  .section__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda-escura);
    margin: 0 0 var(--space-3);
  }

  .section__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.05;
    color: var(--tinta);
    margin: 0;
    max-width: 22ch;
  }

  /* ====== PROPOSTAS ====== */
  .propostas {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--papel);
  }

  .propostas__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 700px) {
    .propostas__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .propostas__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .proposta-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--papel-puro);
    border: 1px solid var(--papel-sombra);
    border-radius: var(--radius-lg);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .proposta-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .proposta-card__top {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--papel-sombra);
  }

  .proposta-card__numero {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--mostarda-escura);
    font-weight: var(--weight-medium);
  }

  .proposta-card__titulo {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--tinta);
    margin: 0;
    line-height: 1.15;
  }

  .proposta-card__resumo {
    font-family: var(--font-corpo);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--tinta-media);
    margin: 0 0 var(--space-5);
  }

  .proposta-card__resumo:empty { display: none; }

  .proposta-card__acoes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .proposta-card__acoes li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    font-family: var(--font-corpo);
    font-size: var(--text-sm);
    color: var(--tinta-media);
    line-height: var(--leading-snug);
  }

  .proposta-card__bullet {
    color: var(--mostarda-escura);
    flex-shrink: 0;
    font-weight: var(--weight-bold);
  }

  .propostas__cta {
    margin-top: var(--space-8);
  }

  /* ====== QUOTES ====== */
  .quotes {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--papel-puro);
    border-block: 1px solid var(--papel-sombra);
  }

  .quotes__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    max-width: 72rem;
    margin-inline: auto;
  }

  @media (min-width: 700px) {
    .quotes__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .quotes__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .quote-item {
    padding: var(--space-5);
    background: var(--papel);
    border-left: 3px solid var(--mostarda);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .quote-item__num {
    display: block;
    color: var(--mostarda-escura);
    margin-bottom: var(--space-3);
  }

  .quote-item__text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    line-height: 1.4;
    color: var(--tinta);
    margin: 0;
  }

  /* ====== GALERIA (com lightbox, sem legenda) ====== */
  .galeria {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--papel);
  }

  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 200px;
    gap: var(--space-3);
  }

  @media (min-width: 700px) {
    .galeria__grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 220px;
    }
  }

  @media (min-width: 1024px) {
    .galeria__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 240px;
      gap: var(--space-4);
    }
  }

