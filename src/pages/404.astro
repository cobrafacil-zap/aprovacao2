---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Página não encontrada — Juliana Constantino 1424"
  description="A página que você procura não existe ou mudou de endereço."
  noindex
>
  <section class="notfound">
    <div class="container">
      <p class="notfound__eyebrow">Erro 404</p>
      <h1 class="notfound__title">
        Essa página não tá no comitê.
      </h1>
      <p class="notfound__body">
        Pode ser que o link tenha mudado, ou que a página nunca tenha existido.
        De qualquer jeito, volta pro início ou fala direto comigo no WhatsApp.
      </p>
      <div class="notfound__actions">
        <Button href="/" variant="primary" size="lg">Voltar pro início</Button>
        <Button href="/propostas/" variant="outline" size="lg">Ver propostas</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    padding-block: clamp(4rem, 12vw, 10rem);
    background: var(--papel);
    min-height: 60vh;
  }

  .notfound__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda-escura);
    margin: 0 0 var(--space-3);
  }

  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    color: var(--tinta);
    margin: 0 0 var(--space-4);
    max-width: 18ch;
  }

  .notfound__body {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.0625rem, 1.9vw, 1.4375rem);
    color: var(--tinta-media);
    margin: 0 0 var(--space-7);
    max-width: 32rem;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
