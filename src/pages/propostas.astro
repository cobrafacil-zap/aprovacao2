---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE, PILLARS, PROPOSALS } from '../site.config.js';
---

<Layout
  title={`Propostas — ${SITE.name} · ${SITE.role}`}
  description="As seis frentes de trabalho da candidata a Deputada Federal Juliana Constantino — menos privilégio, mais resultado."
  pageType="article"
>
  <article class="page">
    <header class="page-hero">
      <div class="container">
        <p class="page-hero__eyebrow">
          <span class="page-hero__crumb">Início / </span>Propostas
        </p>
        <h1 class="page-hero__title">
          Seis frentes de trabalho pra Deputada Federal.
        </h1>
        <p class="page-hero__lede">
          Trabalho começa em proposta concreta. Cada item abaixo é um compromisso
          que dá pra cobrar — em audiência pública, em prestação de contas, em
          rede social. Se você discorda de algum, manda mensagem. Quero debater.
        </p>
      </div>
    </header>

    <!-- SUMÁRIO -->
    <nav class="page-toc" aria-label="Sumário das propostas">
      <div class="container">
        <p class="page-toc__label">Sumário</p>
        <ol class="page-toc__list">
          {PILLARS.map((p) => (
            <li>
              <a href={`#${p.id}`}>
                <span class="page-toc__num">{p.numero}</span>
                <span>{p.titulo}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <!-- EIXOS PRINCIPAIS -->
    <section class="eixos" aria-label="Eixos de campanha">
      <div class="container">
        {PILLARS.map((p) => (
          <article class="eixo" id={p.id}>
            <header class="eixo__header">
              <span class="eixo__numero">{p.numero}</span>
              <h2 class="eixo__titulo">{p.titulo}</h2>
              <p class="eixo__resumo">{p.resumo}</p>
            </header>

            <ul class="eixo__acoes">
              {p.acoes.map((acao) => (
                <li class="eixo__acao">
                  <span class="eixo__acao-marker" aria-hidden="true">→</span>
                  <span>{acao}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- PROPOSTAS DETALHADAS — RECORTE JUNDIAÍ -->
    <section class="detalhes" aria-label="Propostas detalhadas">
      <div class="container">
        <header class="detalhes__header">
          <p class="section-eyebrow">Recorte local · Jundiaí-SP</p>
          <h2 class="section-title">Onde a cidade entra na pauta nacional</h2>
          <p class="detalhes__intro">
            Deputado federal não vota lei pra cidade, mas vota orçamento e
            fiscaliza execução. Esses pontos são onde Jundiaí aparece na minha
            pauta — e onde você pode cobrar resultado.
          </p>
        </header>

        <div class="detalhes__grid">
          {PROPOSALS.map((p) => (
            <article class="proposta-card proposta-card--detalhe">
              <header>
                <span class="proposta-card__numero">{p.numero}</span>
                <h3>{p.titulo}</h3>
              </header>
              <p class="proposta-card__intro">{p.intro}</p>
              <ul>
                {p.corpo.map((c) => (
                  <li>
                    <span class="proposta-card__bullet" aria-hidden="true">—</span>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-final cta-final--soft">
      <div class="container">
        <h2 class="cta-final__title">Tem uma pauta que não viu aqui?</h2>
        <p class="cta-final__body">
          Manda por WhatsApp. Não prometo aderir a tudo, mas prometo ler e
          responder. Campanha é conversa — não panfleto.
        </p>
        <div class="cta-final__actions">
          <Button
            href={`https://wa.me/${SITE.contacts.whatsapp}?text=${encodeURIComponent('Tenho uma pauta pra sugerir. Vim pelo site.')}`}
            variant="primary"
            size="lg"
            external
          >
            Mandar sugestão
          </Button>
          <Button href="/" variant="outline" size="lg">
            Voltar pro início
          </Button>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .page { background: var(--papel); }

  .page-hero {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background: var(--papel-puro);
    border-bottom: 1px solid var(--papel-sombra);
  }

  .page-hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda-escura);
    margin: 0 0 var(--space-3);
  }
  .page-hero__crumb { color: var(--tinta-suave); }

  .page-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: var(--tinta);
    margin: 0 0 var(--space-4);
    max-width: 22ch;
  }

  .page-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.0625rem, 1.9vw, 1.4375rem);
    line-height: 1.45;
    color: var(--tinta-media);
    margin: 0;
    max-width: 38rem;
  }

  /* TOC */
  .page-toc {
    padding-block: var(--space-5);
    background: var(--papel);
    border-bottom: 1px solid var(--papel-sombra);
    position: sticky;
    top: 72px;
    z-index: var(--z-sticky);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .page-toc__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda-escura);
    margin: 0 0 var(--space-3);
  }

  .page-toc__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .page-toc__list a {
    display: inline-flex;
    gap: var(--space-2);
    align-items: baseline;
    padding: 0.375rem 0.75rem;
    background: var(--papel-puro);
    border: 1px solid var(--papel-sombra);
    border-radius: var(--radius-full);
    font-family: var(--font-corpo);
    font-size: var(--text-sm);
    color: var(--tinta);
    text-decoration: none;
    transition: border-color var(--transition-rapida), background var(--transition-rapida);
  }

  .page-toc__list a:hover {
    border-color: var(--mostarda-escura);
    background: var(--papel-sombra);
  }

  .page-toc__num {
    font-family: var(--font-mono);
    color: var(--mostarda-escura);
    font-weight: var(--weight-medium);
  }

  /* EIXOS */
  .eixos {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .eixo {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--papel-sombra);
  }

  @media (min-width: 880px) {
    .eixo {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-10);
    }
  }

  .eixo:last-child { border-bottom: 0; }

  .eixo__header { max-width: 36rem; }

  .eixo__numero {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--mostarda-escura);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
  }

  .eixo__titulo {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.15;
    color: var(--tinta);
    margin: var(--space-3) 0 var(--space-4);
  }

  .eixo__resumo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--tinta-media);
    margin: 0;
  }

  .eixo__acoes {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .eixo__acao {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--papel-puro);
    border-left: 3px solid var(--mostarda);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .eixo__acao-marker {
    color: var(--mostarda-escura);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
  }

  .eixo__acao span:last-child {
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--tinta);
  }

  /* DETALHES */
  .detalhes {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--papel-puro);
    border-block: 1px solid var(--papel-sombra);
  }

  .detalhes__header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--papel-sombra);
    max-width: 36rem;
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda-escura);
    margin: 0 0 var(--space-3);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.1;
    color: var(--tinta);
    margin: 0 0 var(--space-4);
  }

  .detalhes__intro {
    font-family: var(--font-corpo);
    font-style: italic;
    color: var(--tinta-media);
    margin: 0;
  }

  .detalhes__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 720px) {
    .detalhes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .proposta-card--detalhe {
    background: var(--papel);
  }

  .proposta-card--detalhe header {
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--papel-sombra);
  }

  .proposta-card--detalhe h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.2;
    color: var(--tinta);
    margin: var(--space-2) 0 0;
  }

  .proposta-card__intro {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--tinta-media);
    margin: 0 0 var(--space-4);
    line-height: 1.5;
  }

  .proposta-card--detalhe ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .proposta-card--detalhe ul li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
    font-family: var(--font-corpo);
    font-size: var(--text-sm);
    color: var(--tinta-media);
    line-height: var(--leading-relaxed);
  }

  .proposta-card__bullet {
    color: var(--mostarda-escura);
  }

  /* CTA FINAL */
  .cta-final--soft {
    background: var(--papel);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .cta-final--soft .cta-final__title {
    color: var(--tinta);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-4);
  }

  .cta-final--soft .cta-final__body {
    color: var(--tinta-media);
    margin: 0 0 var(--space-6);
    max-width: 36rem;
  }

  .cta-final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
