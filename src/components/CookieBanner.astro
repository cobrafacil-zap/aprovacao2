---
/**
 * Banner de cookies — versão discreta, no canto inferior direito.
 * Não cobre o conteúdo. Pode ser dispensado com 1 clique.
 *
 * Res. CD/ANPD nº 4/2023 — opt-in real, recusa tão fácil quanto aceite.
 */

const STORAGE_KEY = 'ju:cookie-consent';
---

<div
  class="cookie-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
  data-cookie-banner
  hidden
>
  <div class="cookie-banner__card">
    <div class="cookie-banner__body">
      <p class="cookie-banner__title">Cookies</p>
      <p class="cookie-banner__text">
        Usamos cookies pra medir audiência. Você pode aceitar ou rejeitar.{' '}
        <a href="/politica-de-privacidade/">Saiba mais</a>.
      </p>
    </div>
    <div class="cookie-banner__actions">
      <button class="cookie-banner__btn cookie-banner__btn--ghost" data-cookie-reject>
        Rejeitar
      </button>
      <button class="cookie-banner__btn cookie-banner__btn--primary" data-cookie-accept>
        Aceitar
      </button>
    </div>
  </div>
</div>

<script define:vars={{ STORAGE_KEY }}>
  (function () {
    const banner = document.querySelector('[data-cookie-banner]');
    if (!banner) return;

    const acceptBtn = banner.querySelector('[data-cookie-accept]');
    const rejectBtn = banner.querySelector('[data-cookie-reject]');

    function readConsent() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); }
      catch { return null; }
    }

    function writeConsent(consent) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(consent)); }
      catch { /* storage bloqueado: ok */ }
    }

    function hide() {
      banner.style.opacity = '0';
      banner.style.transform = 'translateY(8px)';
      setTimeout(() => { banner.hidden = true; }, 200);
    }

    if (!readConsent()) {
      banner.hidden = false;
      requestAnimationFrame(() => {
        banner.style.opacity = '1';
        banner.style.transform = 'translateY(0)';
      });
    }

    acceptBtn?.addEventListener('click', () => {
      writeConsent({ essencial: true, analise: true, ts: Date.now() });
      hide();
    });

    rejectBtn?.addEventListener('click', () => {
      writeConsent({ essencial: true, analise: false, ts: Date.now() });
      hide();
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: var(--z-cookie);
    max-width: 22rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  @media (min-width: 720px) {
    .cookie-banner { bottom: 1.5rem; right: 1.5rem; max-width: 24rem; }
  }

  .cookie-banner__card {
    background: var(--tinta);
    color: var(--papel);
    border-radius: var(--radius-lg);
    padding: 1rem 1.125rem;
    box-shadow: 0 12px 32px -8px rgba(17, 17, 17, 0.35);
    display: grid;
    gap: 0.75rem;
  }

  .cookie-banner__title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--mostarda);
    margin: 0 0 0.25rem;
  }

  .cookie-banner__text {
    font-family: var(--font-corpo);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(245, 241, 232, 0.85);
    margin: 0;
  }

  .cookie-banner__text a {
    color: var(--mostarda);
    text-decoration: underline;
  }

  .cookie-banner__actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
  }

  .cookie-banner__btn {
    padding: 0.4375rem 0.875rem;
    font-family: var(--font-corpo);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .cookie-banner__btn--ghost {
    background: transparent;
    color: rgba(245, 241, 232, 0.7);
  }
  .cookie-banner__btn--ghost:hover { color: var(--papel); }

  .cookie-banner__btn--primary {
    background: var(--mostarda);
    color: var(--tinta);
  }
  .cookie-banner__btn--primary:hover { background: var(--mostarda-viva); }
</style>
