---
/**
 * Barra flutuante de redes sociais (substitui o WhatsApp Float).
 * Não obstrui conteúdo — fica discreta no canto inferior.
 */
import { SITE } from '../site.config.js';

const instagram = SITE.contacts.instagram;
const tiktok = SITE.contacts.tiktok;
const facebook = SITE.contacts.facebook;
---

<aside class="social-float" aria-label="Acompanhe nas redes sociais">
  <p class="social-float__label">Acompanhe</p>
  <ul class="social-float__list">
    {instagram && (
      <li>
        <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
          </svg>
        </a>
      </li>
    )}
    {tiktok && (
      <li>
        <a href={tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.6 7.6a5.7 5.7 0 0 1-3.4-1.1 5.7 5.7 0 0 1-2.2-4V2h-3v12.6a2.7 2.7 0 1 1-2-2.6V9a5.7 5.7 0 1 0 5 5.6V9.5a8.6 8.6 0 0 0 5.6 2V8.6a5.7 5.7 0 0 1-1 0z"/>
          </svg>
        </a>
      </li>
    )}
    {facebook && (
      <li>
        <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14 13.5h2.5l1-4H14V7c0-1.1.5-2 2-2h1.5V1.7A18.4 18.4 0 0 0 15.4 1.5C13 1.5 11.5 3 11.5 5.6v3.9H9v4H11.5V22h2.5v-8.5z"/>
          </svg>
        </a>
      </li>
    )}
  </ul>
</aside>

<style>
  .social-float {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: var(--z-sticky);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  @media (min-width: 720px) {
    .social-float { bottom: 1.5rem; right: 1.5rem; }
  }

  .social-float__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tag);
    color: var(--tinta-suave);
    margin: 0;
    padding: 0.25rem 0.625rem;
    background: var(--papel);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-card);
  }

  .social-float__list {
    display: flex;
    gap: 0.375rem;
    background: var(--tinta);
    padding: 0.5rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-hero);
  }

  .social-float__list a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--papel);
    background: transparent;
    border-radius: 50%;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .social-float__list a:hover {
    background: var(--mostarda);
    color: var(--tinta);
  }
</style>
