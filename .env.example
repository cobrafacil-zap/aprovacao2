# ============================================================
# Cassarotti Leads — variáveis de ambiente
# Copie para .env (rodar local) ou cadastre no painel do seu
# servidor (Vercel, Railway, VPS etc.). Nenhum valor é obrigatório
# para SUBIR o site — só para banco, WhatsApp e senha do painel.
# ============================================================

# ---- Painel administrativo (/admin) ----
# Senha de acesso ao painel. Padrão se não definida: Comsoc1#
ADMIN_SENHA=Comsoc1#

# ---- Banco de dados (obrigatório em produção) ----
# Upstash Redis via REST. Aceita os dois nomes de variável:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  (nomes oficiais Upstash)
#   KV_REST_API_URL / KV_REST_API_TOKEN                (nomes alternativos)
# Sem banco configurado, em desenvolvimento os dados vão para ./data/*.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- WhatsApp (notificação de novos leads em grupo) — opcional ----
# Evolution API. Também configurável em /admin → Configurações.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Grupo que recebe os avisos. Pode ser definido aqui (JID do grupo,
# ex.: 1203630...@g.us) ou escolhido em /admin → Configurações.
EVOLUTION_GROUP_ID=

# ---- Servidor local (apenas para `npm start`) ----
# PORT=3000
